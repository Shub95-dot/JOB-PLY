# Job APIs (free)
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional: better cover letters
ANTHROPIC_API_KEY=

# Optional: daily digest email. Gmail: smtp.gmail.com / 587 / your address / an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=

# Discord: channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
# (DISCORD_APPLICATIONS_WEBHOOK from the old JOB-PLY .env also works)
